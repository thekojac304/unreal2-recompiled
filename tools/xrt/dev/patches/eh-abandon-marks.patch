+
+/* a longjmp to `keep` abandons every landing record above it: their host frames are gone, so their monitor marks
+ * must go too (otherwise each caught exception leaks one mark per abandoned guarded frame) */
+static void pad_abandon_above(CPU* c, XrtEhPad* keep) {
+    XrtThread* t = c->thread;
+    XrtEhPad* q;
+    for (q = t->eh_pads; q && q != keep; q = q->prev)
+        ;
+    if (!q)
+        xrt_fatal(c, XRT_EXIT_UNSUPPORTED, "C++ EH: landing record for node %08x is not on the landing stack", keep->node);
+    for (q = t->eh_pads; q != keep; q = q->prev) {
+        q->active = 0;
+        xm_forget(q);
+    }
+    t->eh_pads = keep;
