+    for (i = 0; i < nvirtual; i++) if (virtual_blocks[i].live && virtual_blocks[i].base == base) {
+        virtual_blocks[i].live = 0; virtual_blocks[i].warm = 1;
+        ReleaseSRWLockExclusive(&virtual_lock);
+        return 1;
+    }
+    ReleaseSRWLockExclusive(&virtual_lock);
+    return 0;
+}
