+/* Development profile only, with no --trace-full/--trace-address selection: these pure CRT leaves are called millions
+ * of times by name lookups and cost ~2 us each to record, against ns to execute. Their calls[] counts remain; any
+ * fault still reaches xrt_fatal, which records its own FATAL event. */
+static int stub_quiet(const char* key) {
+    static const char* const leaves[] = {
+        "msvcr70.dll!toupper", "msvcr70.dll!tolower", "msvcr70.dll!towupper", "msvcr70.dll!towlower",
+        "msvcr70.dll!wcslen", "msvcr70.dll!strlen", "msvcr70.dll!_wcsicmp", "msvcr70.dll!_stricmp",
+        "msvcr70.dll!_wcsnicmp", "msvcr70.dll!_strnicmp", "msvcr70.dll!wcscmp", "msvcr70.dll!wcsncmp",
+        "msvcr70.dll!wcscpy", "msvcr70.dll!wcsncpy", "msvcr70.dll!wcscat", "msvcr70.dll!wcsstr",
+        "msvcr70.dll!wcschr", "msvcr70.dll!wcsrchr", "msvcr70.dll!_msize", "winmm.dll!timeGetTime"};
+    const char *profile = getenv("XRT_MONITOR_PROFILE"), *full = getenv("XRT_DEV_TRACE_FULL"),
+               *address = getenv("XRT_DEV_TRACE_ADDRESS");
+    size_t i;
+    if (!profile || strcmp(profile, "development") || (full && *full) || (address && *address))
+        return 0;
+    for (i = 0; i < sizeof leaves / sizeof leaves[0]; i++)
+        if (!strcmp(key, leaves[i]))
+            return 1;
+    return 0;
+}
+
 static uint32_t stub_for(const char* key, XrtFn fn) {
