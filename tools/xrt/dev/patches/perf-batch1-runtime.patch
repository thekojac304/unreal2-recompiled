+static int same_basename(const wchar_t* path, const char* name) {
+    const wchar_t* b = path;
+    const wchar_t* p;
+    for (p = path; *p; p++)
+        if (*p == L'\\' || *p == L'/')
+            b = p + 1;
+    for (; *b && *name; b++, name++)
+        if (towlower(*b) != (wint_t)tolower((unsigned char)*name))
+            return 0;
+    return !*b && !*name;
