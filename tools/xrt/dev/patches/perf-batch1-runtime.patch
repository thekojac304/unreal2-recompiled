+static struct { const char* file; const XrtPcLine* lines; uint32_t n; } pcl_tabs[4096];
+static int npcl;
+void xrt_pclines_register(const char* file, const XrtPcLine* lines, uint32_t n) {
+    if (npcl < (int)(sizeof pcl_tabs / sizeof pcl_tabs[0])) {
