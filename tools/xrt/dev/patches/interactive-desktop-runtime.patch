diff --git a/out/dev-init/runtime/port_settings.c b/out/dev-init/runtime/port_settings.c
new file mode 100644
index 0000000..740530f
--- /dev/null
+++ b/out/dev-init/runtime/port_settings.c
@@ -0,0 +1,151 @@
+/* Port settings: walking speed and UI scale.
+ *
+ * Persistence is the game's own: the settings helper U2Port.PortSettings (tools/xrt/dev/port/U2Port, registered by
+ * the port's UIScripts/U2Menus.ui) keeps them as config(User) variables, i.e. User.ini [U2Port.PortSettings]
+ * WalkingSpeed=<percent 75..200> and UIScale=<0 Auto | 100 | 125 | 150 | 200>. This file reads that section once
+ * from the guest's System\User.ini (before the first use) and then follows changes the helper sends through the
+ * console command "PORTSET <Key> <Value>", which UWindowsViewport::Exec would otherwise reject as unknown. Missing or
+ * out-of-range values mean the original behaviour (100%, UI unscaled).
+ *
+ * Walking speed: tools/xrt/dev/native/walk_speed.c wraps APawn::calcVelocity for the call from APawn::physWalking.
+ *
+ * UI scale S: UUIConsole::PostRender sizes the UI root from the viewport and calls Root->Update(Frame, Renderer).
+ * For that one call the root is laid out at 1/S of its size and location and the FUIRenderer's own scale stack
+ * (PushScale/PopScale, vtable +0x18/+0x1c, as UScaleContainer uses it) draws it S times larger, so anchors, margins,
+ * centring and the cursor/hit-testing all stay in one (virtual) coordinate space. UScaleContainer, which already
+ * scales its children to the whole viewport, gets the inverse 1/S around its own update. */
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdlib.h>
+#include <wchar.h>
+#include "xrt_internal.h"
+
+static int loaded, walk_percent = 100, ui_choice = 100;
+static volatile float walk_factor = 1.0f;
+static unsigned logged;
+
+static int valid_walk(int p) { return p >= 75 && p <= 200 && p % 5 == 0; }
+static int valid_ui(int p) { return p == 0 || p == 100 || p == 125 || p == 150 || p == 200; }
+static void set_walk(int p, const char* source) {
+    if (!valid_walk(p)) { xrt_log("port: WalkingSpeed %d ignored (%s; 75..200 in steps of 5)", p, source); return; }
+    walk_percent = p; walk_factor = (float)p / 100.0f;
+    xrt_log("port: walking speed %d%% (%s)", p, source);
+    xrt_event("port_setting", "\"key\":\"WalkingSpeed\",\"value\":%d,\"source\":\"%s\"", p, source);
+}
+static void set_ui(int p, const char* source) {
+    if (!valid_ui(p)) { xrt_log("port: UIScale %d ignored (%s; 0 Auto, 100, 125, 150, 200)", p, source); return; }
+    ui_choice = p;
+    xrt_log("port: UI scale %s%d (%s)", p ? "" : "Auto/", p, source);
+    xrt_event("port_setting", "\"key\":\"UIScale\",\"value\":%d,\"source\":\"%s\"", p, source);
+}
+static void load(void) {
+    XrtModule* exe;
+    char path[600], *slash;
+    if (loaded) return;
+    loaded = 1;
+    exe = xrt_module_by_name("Unreal2.exe");
+    if (!exe) return;
+    snprintf(path, sizeof path, "%s", exe->path);
+    slash = strrchr(path, '\\');
+    if (!slash) return;
+    snprintf(slash + 1, sizeof path - (size_t)(slash + 1 - path), "User.ini");
+    set_walk((int)GetPrivateProfileIntA("U2Port.PortSettings", "WalkingSpeed", 100, path), "User.ini");
+    set_ui((int)GetPrivateProfileIntA("U2Port.PortSettings", "UIScale", 100, path), "User.ini");
+}
+
+float xrt_port_walking_speed(void) {
+    if (!loaded) load();
+    return walk_factor;
+}
+
+/* Auto: the menus and HUD are laid out for about 1024x768 pixels; keep their height near the original 1024x768
+ * proportion (768 of 1024 lines) - the largest offered scale with 768*S <= 0.75*height: 1080 lines -> 100%,
+ * 1369/1440 -> 125%, 1600 -> 150%, 2160 -> 200%. The executable is DPI-unaware, so on a high-DPI monitor Windows already
+ * presents it in logical pixels; the height here is the actual client (back buffer) height. */
+static float ui_scale(uint32_t height) {
+    static const int choices[] = {200, 150, 125};
+    int p = ui_choice, i;
+    if (!loaded) load();
+    if (!p) {
+        p = 100;
+        for (i = 0; i < 3; i++) if (768.0 * choices[i] / 100.0 <= 0.75 * height) { p = choices[i]; break; }
+    }
+    return (float)p / 100.0f;
+}
+
+/* "PORTSET Key Value" (UTF-16, as UWindowsViewport::Exec receives it). Returns 1 when the command was ours. */
+static int port_command(const uint16_t* s) {
+    wchar_t text[96], key[32];
+    int n, value;
+    for (n = 0; n < 95 && s[n]; n++) text[n] = (wchar_t)s[n];
+    text[n] = 0;
+    if (_wcsnicmp(text, L"PORTSET ", 8)) return 0;
+    if (swscanf(text + 8, L"%31ls %d", key, &value) != 2) { xrt_log("port: malformed command \"%ls\"", text); return 1; }
+    if (!_wcsicmp(key, L"WalkingSpeed")) set_walk(value, "menu");
+    else if (!_wcsicmp(key, L"UIScale")) set_ui(value, "menu");
+    else xrt_log("port: unknown setting \"%ls\"", key);
+    return 1;
+}
+
+/* Guest calls on the current thread (thiscall: ECX = object). */
+static uint32_t guest_thiscall(CPU* c, uint32_t self, uint32_t fn, int nargs, const uint32_t* args) {
+    c->r[ECX] = self;
+    return xrt_call_guest(c, fn, nargs, args, 1);
+}
+static uint32_t scratch_dimension(CPU* c, float x, float y) {
+    c->r[ESP] -= 16;
+    wrf32(c->r[ESP], x); wrf32(c->r[ESP] + 4, y);
+    return c->r[ESP];
+}
+static void push_scale(CPU* c, uint32_t renderer, float s) {
+    uint32_t esp = c->r[ESP], dim = scratch_dimension(c, s, s);
+    guest_thiscall(c, renderer, rd32(rd32(renderer) + 0x18), 1, &dim);
+    c->r[ESP] = esp;
+}
+static void pop_scale(CPU* c, uint32_t renderer) { guest_thiscall(c, renderer, rd32(rd32(renderer) + 0x1c), 0, NULL); }
+
+/* UI.dll (preferred base 0x10000000) RVAs, from its exports and UUIConsole::PostRender. */
+enum { UI_ROOT_UPDATE_RETURN = 0x7f82b, UI_GET_SIZE = 0x417e0, UI_GET_LOCATION = 0x41530, UI_SET_SIZE = 0x3e640,
+       UI_SET_LOCATION = 0x3e430 };
+
+/* kind 1: UWindowsViewport::Exec(const TCHAR*, FOutputDevice&); 2: UComponentHandle::Update(FSceneNode*, FUIRenderer*);
+ * 3: UScaleContainer::Update(FSceneNode*, FUIRenderer*). Returns 1 when the call was completed here. */
+int xrt_port_call(CPU* c, unsigned kind, XrtFn fn) {
+    uint32_t esp = c->r[ESP], ret = rd32(esp), self = c->r[ECX];
+    if (kind == 1) {
+        uint32_t s = rd32(esp + 4);
+        if (!s || !port_command((const uint16_t*)G2H(s))) return 0;
+        c->r[EAX] = 1; c->rv = pop32(c); c->r[ESP] += 8;
+        return 1;
+    } else {
+        XrtModule* ui = xrt_module_by_addr(ret);
+        uint32_t frame = rd32(esp + 4), renderer = rd32(esp + 8), viewport = frame ? rd32(frame + 4) : 0;
+        float s;
+        if (!ui || !viewport) return 0;
+        s = ui_scale(rd32(viewport + 0x78));
+        if (s == 1.0f) return 0;
+        if (kind == 2) {
+            uint32_t out, args[1], dim;
+            float w, h, x, y;
+            if (ret - ui->base != UI_ROOT_UPDATE_RETURN) return 0;
+            /* layout at 1/S: root size and location as PostRender set them this frame, divided by S */
+            c->r[ESP] -= 16; out = c->r[ESP];
+            args[0] = out; guest_thiscall(c, self, ui->base + UI_GET_SIZE, 1, args);
+            w = rdf32(out); h = rdf32(out + 4);
+            guest_thiscall(c, self, ui->base + UI_GET_LOCATION, 1, args);
+            x = rdf32(out); y = rdf32(out + 4);
+            c->r[ESP] = esp;
+            dim = scratch_dimension(c, w / s, h / s); guest_thiscall(c, self, ui->base + UI_SET_SIZE, 1, &dim); c->r[ESP] = esp;
+            dim = scratch_dimension(c, x / s, y / s); guest_thiscall(c, self, ui->base + UI_SET_LOCATION, 1, &dim); c->r[ESP] = esp;
+            if (logged++ < 8)
+                xrt_log("port: UI root %gx%g at %g,%g laid out at 1/%g, drawn at x%g (viewport height %u)", w, h, x, y, s, s,
+                        rd32(viewport + 0x78));
+        }
+        push_scale(c, renderer, kind == 2 ? s : 1.0f / s);
+        c->r[ECX] = self;
+        fn(c);                                   /* the update itself: pops its return address and two arguments */
+        pop_scale(c, renderer);
+        c->rv = ret;
+        return 1;
+    }
+}
diff --git a/out/dev-init/runtime/viewport_window.inc b/out/dev-init/runtime/viewport_window.inc
new file mode 100644
index 0000000..d7b6d5f
--- /dev/null
+++ b/out/dev-init/runtime/viewport_window.inc
@@ -0,0 +1,34 @@
+/* Windowed maximize. WinDrv's viewport procedure maps SC_MAXIMIZE (Maximize button, caption double-click, window
+ * menu, Win+Up) and Alt+Enter to UWindowsViewport::ToggleFullscreen: TryRenderDevice(..., Fullscreen=1) - exclusive
+ * fullscreen, which this port does not implement (CreateDevice fatal 76, runs 20261101-191847/-191912) - followed by
+ * "set ini:Engine.Engine.ViewportManager StartupFullscreen true". For the top-level viewport window those two requests
+ * are performed here as native WINDOWED maximize/restore and not passed on, so StartupFullscreen is not changed. The
+ * guest then receives the ordinary WM_GETMINMAXINFO/WM_WINDOWPOSCHANGED/WM_SIZE sequence (monitor work area, actual
+ * client size) and resizes its back buffer as for any other resize. SC_RESTORE, every other message, and explicit
+ * fullscreen requests (console TOGGLEFULLSCREEN, video options Fullscreen) still reach the game unchanged. */
+static int viewport_top_window(HWND h) {
+    WCHAR name[64];
+    if(xm_win_GetWindowLongW(h,GWL_STYLE)&WS_CHILD)return 0;
+    return GetClassNameW(h,name,64)>0 && wcsstr(name,L"ViewportWindow")!=NULL;
+}
+static int viewport_windowed_maximize(HWND h,UINT msg,WPARAM wp,LPARAM lp,int wide,LRESULT*result) {
+    static unsigned logged;
+    if(msg==WM_SYSCOMMAND && (wp&0xfff0)==SC_MAXIMIZE && viewport_top_window(h)) {
+        if(logged++<32)xrt_log("viewport SC_MAXIMIZE (%llx): windowed maximize to the monitor work area (not ToggleFullscreen)",(unsigned long long)wp);
+        xrt_event("viewport_windowed_maximize","\"source\":\"syscommand\",\"wparam\":%u",(unsigned)wp);
+        *result=wide?xm_win_DefWindowProcW(h,msg,wp,lp):xm_win_DefWindowProcA(h,msg,wp,lp);
+        return 1;
+    }
+    /* The guest's own test for Alt+Enter: VK_RETURN key-down while GetKeyState(VK_MENU) reports Alt held. */
+    if((msg==WM_KEYDOWN || msg==WM_SYSKEYDOWN) && wp==VK_RETURN && (xm_win_GetKeyState(VK_MENU)&0x8000) && viewport_top_window(h)) {
+        if(!(lp&0x40000000)) { /* first press only, not auto-repeat */
+            int zoomed=IsZoomed(h)!=0;
+            if(logged++<32)xrt_log("viewport Alt+Enter: windowed %s (exclusive fullscreen is not supported)",zoomed?"restore":"maximize");
+            xrt_event("viewport_windowed_maximize","\"source\":\"alt_enter\",\"restore\":%d",zoomed);
+            xm_win_ShowWindow(h,zoomed?SW_RESTORE:SW_MAXIMIZE);
+        }
+        *result=0;
+        return 1;
+    }
+    return 0;
+}
